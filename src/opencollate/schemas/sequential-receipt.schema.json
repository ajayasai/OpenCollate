{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCollate sequential-receipt",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "semantics": {
          "const": "two-valued-synchronous"
        },
        "binding": {
          "type": "object",
          "properties": {
            "request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ir_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "implementation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 32
            },
            "frontend": {
              "type": "string"
            },
            "algorithm": {
              "const": "source-bound-k-induction-v1"
            }
          },
          "required": [
            "request_sha256",
            "ir_sha256",
            "implementation_sha256",
            "sources",
            "frontend",
            "algorithm"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "proven",
            "counterexample",
            "inconclusive"
          ]
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            },
            "resource_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            }
          },
          "required": [
            "timeout_ms",
            "resource_limit"
          ],
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "properties": {
            "name": {
              "const": "z3"
            },
            "version": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "signals": {
              "type": "integer",
              "minimum": 0
            },
            "state_bits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
                "maxLength": 256
              },
              "minItems": 0
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
                "maxLength": 256
              },
              "minItems": 0
            },
            "ir_nodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "locations": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "source",
                  "line",
                  "column"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "signals",
            "state_bits",
            "states",
            "inputs",
            "ir_nodes",
            "locations"
          ],
          "additionalProperties": false
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "proven",
                  "counterexample",
                  "bounded",
                  "uncovered",
                  "inconclusive"
                ]
              },
              "checked_through": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "induction_depth": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cover_cycle": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trace": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "cycle": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "values": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935
                          }
                        }
                      },
                      "required": [
                        "cycle",
                        "values"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 129
                  }
                ]
              },
              "reason": {
                "type": [
                  "null",
                  "string"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "checked_through",
              "induction_depth",
              "cover_cycle",
              "trace",
              "reason"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "proven"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "induction_depth": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "cover_cycle": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "trace": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "counterexample"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "trace": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cycle": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "values": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935
                            }
                          }
                        },
                        "required": [
                          "cycle",
                          "values"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 129
                    },
                    "checked_through": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 32
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "semantics",
        "binding",
        "status",
        "exit_code",
        "limits",
        "backend",
        "model",
        "results",
        "receipt_sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proven"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "counterexample"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "inconclusive"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 2
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "semantics": {
          "const": "two-valued-synchronous"
        },
        "status": {
          "const": "invalid-or-unsupported"
        },
        "exit_code": {
          "type": "integer",
          "const": 2
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "semantics",
        "status",
        "exit_code",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCollate certificate-verification",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "const": "certificate-verified"
        },
        "exit_code": {
          "const": 0
        },
        "encoding": {
          "const": "opencollate-bitblast-rup-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "const": "certificate-verified"
              },
              "induction_depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "cover_cycle": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "base": {
                "$ref": "#/$defs/statistics"
              },
              "step": {
                "$ref": "#/$defs/statistics"
              }
            },
            "required": [
              "id",
              "status",
              "induction_depth",
              "cover_cycle",
              "base",
              "step"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "exit_code",
        "encoding",
        "binding",
        "certificate_sha256",
        "results"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "const": "not-certified"
        },
        "exit_code": {
          "const": 2
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status",
        "exit_code",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ir_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "frontend": {
          "type": "string"
        }
      },
      "required": [
        "request_sha256",
        "ir_sha256",
        "sources",
        "frontend"
      ],
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "clauses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "literals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        }
      },
      "required": [
        "steps",
        "clauses",
        "literals"
      ],
      "additionalProperties": false
    }
  }
}

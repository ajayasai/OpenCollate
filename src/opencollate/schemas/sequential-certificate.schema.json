{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCollate sequential-certificate",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "semantics": {
          "const": "two-valued-synchronous"
        },
        "encoding": {
          "const": "opencollate-bitblast-rup-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "induction_depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "cover": {
                "type": "array",
                "minItems": 1,
                "maxItems": 129,
                "items": {
                  "type": "object",
                  "properties": {
                    "cycle": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 128
                    },
                    "values": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935
                      }
                    }
                  },
                  "required": [
                    "cycle",
                    "values"
                  ],
                  "additionalProperties": false
                }
              },
              "base": {
                "$ref": "#/$defs/evidence"
              },
              "step": {
                "$ref": "#/$defs/evidence"
              }
            },
            "required": [
              "id",
              "induction_depth",
              "cover",
              "base",
              "step"
            ],
            "additionalProperties": false
          }
        },
        "certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "semantics",
        "encoding",
        "binding",
        "claims",
        "certificate_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "const": "not-certified"
        },
        "exit_code": {
          "const": 2
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status",
        "exit_code",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ir_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "frontend": {
          "type": "string"
        }
      },
      "required": [
        "request_sha256",
        "ir_sha256",
        "sources",
        "frontend"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "problem_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "variables": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "clauses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200001
        },
        "proof": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "array",
            "maxItems": 2000000,
            "items": {
              "type": "integer",
              "minimum": -100000,
              "maximum": 100000,
              "not": {
                "const": 0
              }
            }
          }
        }
      },
      "required": [
        "problem_sha256",
        "variables",
        "clauses",
        "proof"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajayasai/OpenCollate/schemas/contract.schema.json",
  "title": "OpenCollate canonical design contract",
  "oneOf": [
    { "$ref": "#/$defs/contract_v1" },
    { "$ref": "#/$defs/contract_v2" }
  ],
  "$defs": {
    "json_value": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      ]
    },
    "range": {
      "type": "object",
      "required": ["left", "right", "step", "width"],
      "properties": {
        "left": { "type": "integer" },
        "right": { "type": "integer" },
        "step": { "enum": [-1, 0, 1] },
        "width": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "required": ["width", "packed", "unpacked"],
      "properties": {
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "left": { "type": "integer" },
        "right": { "type": "integer" },
        "ascending": { "type": "boolean" },
        "packed": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "unpacked": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "bit_indices": { "type": "array", "items": { "type": "integer" } },
        "explicit_scalar": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["canonical_name", "names", "direction", "role", "shape"],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "direction": {
          "enum": ["input", "output", "inout", "internal", "feedthrough", "unknown"]
        },
        "role": {
          "enum": ["signal", "clock", "reset", "power", "ground", "analog", "tie", "unknown"]
        },
        "shape": { "$ref": "#/$defs/shape" }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["canonical_name", "kind", "names", "required_views", "ports"],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["module", "cell", "macro", "pad", "unknown"] },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "required_views": { "type": "array", "items": { "type": "string" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } }
      },
      "additionalProperties": false
    },
    "register_field": {
      "type": "object",
      "required": [
        "canonical_name",
        "names",
        "bit_offset",
        "bit_width",
        "access",
        "reset_value"
      ],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "bit_offset": { "type": ["integer", "null"], "minimum": 0 },
        "bit_width": { "type": ["integer", "null"], "minimum": 1 },
        "access": { "type": ["string", "null"] },
        "reset_value": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "register": {
      "type": "object",
      "required": [
        "canonical_name",
        "component",
        "names",
        "memory_map",
        "address_block",
        "address_offset",
        "absolute_address",
        "size_bits",
        "access",
        "fields"
      ],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "memory_map": { "type": ["string", "null"] },
        "address_block": { "type": ["string", "null"] },
        "address_offset": { "type": ["integer", "null"], "minimum": 0 },
        "absolute_address": { "type": ["integer", "null"], "minimum": 0 },
        "size_bits": { "type": ["integer", "null"], "minimum": 1 },
        "access": { "type": ["string", "null"] },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/register_field" } }
      },
      "additionalProperties": false
    },
    "snapshot_record": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/json_value" }
    },
    "view_snapshot": {
      "type": "object",
      "required": [
        "snapshot_version",
        "view",
        "complete",
        "tainted_scopes",
        "components",
        "pin_mappings",
        "objects",
        "clocks",
        "interfaces",
        "registers",
        "connectivity_endpoints",
        "connectivity_edges",
        "connectivity_requirements",
        "attributes",
        "extensions",
        "content_sha256"
      ],
      "properties": {
        "snapshot_version": { "const": 1 },
        "view": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" },
        "tainted_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "pin_mappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "clocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "registers": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "connectivity_endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "connectivity_edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "connectivity_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot_record" }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "contract_v1": {
      "type": "object",
      "required": ["schema_version", "generated_by", "components"],
      "properties": {
        "schema_version": { "const": 1 },
        "generated_by": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "registers": {
          "type": "array",
          "items": { "$ref": "#/$defs/register" }
        }
      },
      "additionalProperties": false
    },
    "contract_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_by",
        "components",
        "registers",
        "views",
        "extensions"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "generated_by": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "registers": {
          "type": "array",
          "items": { "$ref": "#/$defs/register" }
        },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/view_snapshot" }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      },
      "additionalProperties": false
    }
  }
}

# Synthetic, static UPF. OpenCollate does not execute this as Tcl.
upf_version 3.1
set_design_top uart
create_power_domain PD_UART -include_scope
create_supply_port VDD_CORE -domain PD_UART -direction inout
create_supply_port VSS -domain PD_UART -direction inout
create_supply_net VDD_CORE -domain PD_UART
create_supply_net VSS -domain PD_UART
connect_supply_net VDD_CORE -ports {VDD_CORE}
connect_supply_net VSS -ports {VSS}
set_domain_supply_net PD_UART \
  -primary_power_net VDD_CORE -primary_ground_net VSS \
  -primary_power_port VDD_CORE -primary_ground_port VSS

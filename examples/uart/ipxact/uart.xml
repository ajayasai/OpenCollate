<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic IP-XACT 2014 component for the OpenCollate UART example. -->
<ipxact:component xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2014">
  <ipxact:vendor>opencollate.example</ipxact:vendor>
  <ipxact:library>synthetic</ipxact:library>
  <ipxact:name>uart</ipxact:name>
  <ipxact:version>1.0</ipxact:version>
  <ipxact:busInterfaces>
    <ipxact:busInterface>
      <ipxact:name>CLOCK</ipxact:name>
      <ipxact:busType vendor="opencollate.example" library="signal" name="clock" version="1.0"/>
      <ipxact:abstractionTypes>
        <ipxact:abstractionType>
          <ipxact:abstractionRef vendor="opencollate.example" library="signal"
                                  name="clock_rtl" version="1.0"/>
          <ipxact:portMaps>
            <ipxact:portMap>
              <ipxact:logicalPort><ipxact:name>CLK</ipxact:name></ipxact:logicalPort>
              <ipxact:physicalPort><ipxact:name>clk_i</ipxact:name></ipxact:physicalPort>
            </ipxact:portMap>
          </ipxact:portMaps>
        </ipxact:abstractionType>
      </ipxact:abstractionTypes>
      <ipxact:slave/>
    </ipxact:busInterface>
  </ipxact:busInterfaces>
  <ipxact:memoryMaps>
    <ipxact:memoryMap>
      <ipxact:name>registers</ipxact:name>
      <ipxact:addressUnitBits>8</ipxact:addressUnitBits>
      <ipxact:addressBlock>
        <ipxact:name>uart_regs</ipxact:name>
        <ipxact:baseAddress>0x40001000</ipxact:baseAddress>
        <ipxact:range>0x100</ipxact:range>
        <ipxact:width>32</ipxact:width>
        <ipxact:usage>register</ipxact:usage>
        <ipxact:register>
          <ipxact:name>CTRL</ipxact:name>
          <ipxact:addressOffset>0</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>ENABLE</ipxact:name>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:resets>
              <ipxact:reset><ipxact:value>0</ipxact:value><ipxact:mask>1</ipxact:mask></ipxact:reset>
            </ipxact:resets>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>MODE</ipxact:name>
            <ipxact:bitOffset>4</ipxact:bitOffset>
            <ipxact:bitWidth>2</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
      </ipxact:addressBlock>
    </ipxact:memoryMap>
  </ipxact:memoryMaps>
  <ipxact:model>
    <ipxact:ports>
      <ipxact:port>
        <ipxact:name>clk_i</ipxact:name>
        <ipxact:wire><ipxact:direction>in</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>rst_ni</ipxact:name>
        <ipxact:wire><ipxact:direction>in</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>tx_en_i</ipxact:name>
        <ipxact:wire><ipxact:direction>in</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>data_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:vectors><ipxact:vector><ipxact:left>7</ipxact:left><ipxact:right>0</ipxact:right></ipxact:vector></ipxact:vectors>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>data_o</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>out</ipxact:direction>
          <ipxact:vectors><ipxact:vector><ipxact:left>7</ipxact:left><ipxact:right>0</ipxact:right></ipxact:vector></ipxact:vectors>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>irq_o</ipxact:name>
        <ipxact:wire><ipxact:direction>out</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>tx_active_o</ipxact:name>
        <ipxact:wire><ipxact:direction>out</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>VDD_CORE</ipxact:name>
        <ipxact:wire><ipxact:direction>inout</ipxact:direction></ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>VSS</ipxact:name>
        <ipxact:wire><ipxact:direction>inout</ipxact:direction></ipxact:wire>
      </ipxact:port>
    </ipxact:ports>
  </ipxact:model>
</ipxact:component>
